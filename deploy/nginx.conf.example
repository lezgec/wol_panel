# Instalar como un virtual host separado de Cholesterol Game y SpamKill.
# Sustituir dominio y rutas por el certificado TLS real.
server {
    listen 80;
    server_name wol.tu-dominio.com;
    return 301 https://wol.tu-dominio.com$request_uri;
}
server {
    listen 443 ssl;
    server_name wol.tu-dominio.com;
    ssl_certificate /etc/letsencrypt/live/wol.tu-dominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wol.tu-dominio.com/privkey.pem;
    client_max_body_size 64k;
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
