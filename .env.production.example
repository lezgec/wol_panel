APP_ENV=production
PUBLIC_BASE_URL=https://wol.luiszamora.dev
HOST=127.0.0.1
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wol_panel
DB_USER=wol_user
DB_PASSWORD=
COOKIE_SECURE=1
ALLOW_LOCAL_WOL=0
# 1 para el proxy HTTPS único descrito en DEPLOY_AZURE.md.
TRUST_PROXY_COUNT=1
# Genera dos claves distintas con secrets.token_hex(32).
FLASK_SECRET_KEY=
ALEXA_BRIDGE_SECRET=
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente autorizado por tu proveedor de correo.
SMTP_FROM=
# Credenciales propias del cliente OAuth de esta skill.
ALEXA_CLIENT_ID=
ALEXA_CLIENT_SECRET=
# URLs EXACTAS mostradas por Amazon para esta skill, separadas por comas.
ALEXA_REDIRECT_URIS=
# Permissions > Send Alexa Events; son otras credenciales.
ALEXA_EVENT_CLIENT_ID=
ALEXA_EVENT_CLIENT_SECRET=
ALEXA_REGION=NA
# systemd lo fija a /var/lib/wol-pro. En desarrollo puede usarse ./instance.
WOL_STATE_DIR=/var/lib/wol-pro

# Habilitar solo después de ejecutar migrate_db.py.
ENABLE_WINDOWS_AGENT=0
# ID de la misma skill WoL Pro, ampliada con los modelos Smart Home y Custom.
ALEXA_SKILL_ID=
# Opcional. Por defecto: /var/lib/wol-pro/downloads/WoLPro-Agent-Setup.exe.
# Si todavía no hay instalador, se usa el ZIP portátil existente en esa carpeta.
WOL_AGENT_DOWNLOAD_PATH=
