DB_SERVER=ESCRITORIO
DB_DATABASE=wol_panel
# Opcional: cadena completa para otra instancia o Azure SQL.
DB_CONNECTION_STRING=
MY_CLIENT_ID=
MY_CLIENT_SECRET=
SMTP_USER=
SMTP_PASSWORD=
AMAZON_REDIRECT_URI=https://wol.luiszamora.dev/callback/amazon
# Cliente y secreto que configures en Account Linking de la skill.
# Si están vacíos, se usan MY_CLIENT_ID y MY_CLIENT_SECRET.
ALEXA_CLIENT_ID=
ALEXA_CLIENT_SECRET=
# URLs de retorno exactas de tu skill, separadas por comas.
ALEXA_REDIRECT_URIS=
# Credenciales de la sección Permissions > Send Alexa Events de la skill.
# Son distintas de las credenciales del cliente de Account Linking.
ALEXA_EVENT_CLIENT_ID=
ALEXA_EVENT_CLIENT_SECRET=
# NA para América, EU para Europa, FE para Lejano Oriente.
ALEXA_REGION=NA
WOL_BROADCAST=255.255.255.255
WOL_PORT=9
HOST=0.0.0.0
PORT=5000
# 1 cuando se accede por HTTPS; 0 para http://localhost:5000.
COOKIE_SECURE=0
APP_ENV=development
ALLOW_LOCAL_WOL=1
TRUST_PROXY_COUNT=0
PUBLIC_BASE_URL=
# Misma clave que Lambda; mínimo 32 caracteres. Obligatoria en producción.
ALEXA_BRIDGE_SECRET=
SMTP_FROM=Soporte WoL Pro <support@luiszamora.dev>
# Opcionales: clave persistente y carpeta persistente de autenticación.
FLASK_SECRET_KEY=
WOL_STATE_DIR=
