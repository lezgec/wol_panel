[Unit]
Description=WoL Pro - Flask, Waitress y worker Alexa
Wants=network-online.target
After=network-online.target mariadb.service

[Service]
Type=simple
User=wol
Group=wol
WorkingDirectory=/srv/apps/wakeonlan
EnvironmentFile=/srv/apps/wakeonlan/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=WOL_STATE_DIR=/var/lib/wol-pro
StateDirectory=wol-pro
StateDirectoryMode=0700
UMask=0077
ExecStart=/srv/apps/wakeonlan/.venv/bin/python /srv/apps/wakeonlan/app.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wol-pro
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wol-pro

[Install]
WantedBy=multi-user.target
