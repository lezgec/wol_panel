APP_ENV=production
PUBLIC_BASE_URL=https://wol.tu-dominio.com
COOKIE_SECURE=1
ALLOW_LOCAL_WOL=0
# 1 para el proxy HTTPS único descrito en DEPLOY_AZURE.md.
TRUST_PROXY_COUNT=1
# Genera dos claves distintas con secrets.token_hex(32).
FLASK_SECRET_KEY=
ALEXA_BRIDGE_SECRET=
# La base debe existir. El contenedor incluye ODBC Driver 18.
DB_CONNECTION_STRING="DRIVER={ODBC Driver 18 for SQL Server};SERVER=tcp:tu-servidor.database.windows.net,1433;DATABASE=wol_panel;UID=tu-usuario;PWD=tu-password;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=10;"
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente autorizado por tu proveedor de correo.
SMTP_FROM=Soporte WoL Pro <support@tu-dominio.com>
# Credenciales propias del cliente OAuth de esta skill.
ALEXA_CLIENT_ID=
ALEXA_CLIENT_SECRET=
# URLs EXACTAS mostradas por Amazon para esta skill, separadas por comas.
ALEXA_REDIRECT_URIS=
# Permissions > Send Alexa Events; son otras credenciales.
ALEXA_EVENT_CLIENT_ID=
ALEXA_EVENT_CLIENT_SECRET=
ALEXA_REGION=NA
